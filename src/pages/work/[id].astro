---
import Base from '../../layouts/Base.astro';
import Lifecycle from '../../components/Lifecycle.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({ params: { id: entry.id }, props: { entry, next: work[(i + 1) % work.length] } }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const desktopShots = d.gallery.filter((g) => !g.phone);
const phoneShots = d.gallery.filter((g) => g.phone);
---
<Base title={d.title} description={d.tagline}>
  <article class="case">
    <header class="wrap top">
      <a class="back" href="/#work">← All work</a>
      <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
      <p class="name">{d.title}</p>
      <h1>{d.headline}</h1>
      <dl class="facts">
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        <div><dt>Timeline</dt><dd>{d.period}</dd></div>
        <div><dt>Context</dt><dd>{d.company}</dd></div>
        <div><dt>Status</dt><dd><span class:list={['status', d.status.replace(' ', '-')]}>{d.status}</span></dd></div>
        {d.link && <div><dt>Live</dt><dd><a href={d.link}>{d.link.replace(/^https?:\/\//, '')} ↗</a></dd></div>}
      </dl>
    </header>

    <section class="wrap por">
      <div><p class="label">Problem</p><p>{d.problem}</p></div>
      <div><p class="label">Outcome</p><p>{d.outcome}</p></div>
    </section>

    {d.metrics.length > 0 && (
      <section class="wrap">
        <ul class="metrics">{d.metrics.map((m) => <li><strong>{m.value}</strong><span>{m.label}</span></li>)}</ul>
      </section>
    )}

    <section class="wrap"><div class="life"><Lifecycle stages={d.stages} /></div></section>

    {d.video && (
      <figure class="wrap media">
        <video src={d.video} poster={d.cover} controls muted playsinline preload="none"></video>
        <figcaption>A short tour of the live product.</figcaption>
      </figure>
    )}
    {!d.video && d.cover && d.kind === 'independent' && <figure class="wrap media"><img src={d.cover} alt={`${d.title}`} width="1440" height="900" /></figure>}
    {d.kind === 'enterprise' && <p class="wrap note">Client work: described without screenshots, client names or confidential figures.</p>}

    {d.beforeAfter.length > 0 && (
      <section class="wrap sec">
        <h2>Before and after</h2>
        <div class="ba" role="table" aria-label="Before and after">
          <div class="ba-row ba-head" role="row"><span role="columnheader"></span><span role="columnheader">Before</span><span role="columnheader">After</span></div>
          {d.beforeAfter.map((r) => (
            <div class="ba-row" role="row"><span class="ba-area" role="rowheader">{r.area}</span><span class="ba-b" role="cell">{r.before}</span><span class="ba-a" role="cell">{r.after}</span></div>
          ))}
        </div>
      </section>
    )}

    {d.flow.length > 0 && (
      <section class="wrap sec">
        <h2>{d.kind === 'enterprise' ? 'How it works' : 'How it works now'}</h2>
        <ol class="flow">{d.flow.map((f, i) => <li><span>{String(i + 1).padStart(2, '0')}</span><h3>{f.title}</h3><p>{f.body}</p></li>)}</ol>
      </section>
    )}

    <section class="wrap sec prose"><Content /></section>

    {d.gallery.length > 0 && (
      <section class="wrap sec">
        <h2>Screens</h2>
        {desktopShots.length > 0 && <div class="shots">{desktopShots.map((g) => <figure><img src={g.src} alt={g.alt} loading="lazy" /><figcaption>{g.alt}</figcaption></figure>)}</div>}
        {phoneShots.length > 0 && <div class="phones">{phoneShots.map((g) => <figure><img src={g.src} alt={g.alt} loading="lazy" /><figcaption>{g.alt}</figcaption></figure>)}</div>}
      </section>
    )}

    {d.caveats.length > 0 && (
      <section class="wrap sec">
        <div class="caveats"><h2>What's still open</h2><ul>{d.caveats.map((c) => <li>{c}</li>)}</ul></div>
      </section>
    )}

    {d.stack.length > 0 && (
      <section class="wrap sec"><p class="label">Stack and tools</p><div class="stack">{d.stack.map((s) => <span class="tag">{s}</span>)}</div></section>
    )}

    <nav class="wrap nextcase" aria-label="Next case study">
      <a href={`/work/${next.id}/`}><span>Next case study</span><strong>{next.data.title} →</strong><em>{next.data.headline}</em></a>
    </nav>
  </article>
</Base>

<style>
  .top { padding-top: 40px }
  .back { font-weight: 600; text-decoration: none; font-size: 15px }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 28px 0 14px }
  .name { font: 600 14px var(--mono); letter-spacing: .1em; text-transform: uppercase; margin: 0 }
  h1 { font-size: clamp(34px, 5.6vw, 64px); margin: 10px 0 0; max-width: 20ch; letter-spacing: -.03em }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0 24px; margin: 40px 0 0; border-top: 1px solid var(--line) }
  .facts div { padding: 14px 0; border-bottom: 1px solid var(--line); min-width: 0 }
  .facts dt, .label { font: 500 11px var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 0 0 4px }
  .facts dd { margin: 0; font-size: 15px; overflow-wrap: anywhere }
  .facts a { text-decoration: none }
  .por { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 48px }
  .por > div { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 22px 24px }
  .por p:last-child { margin: 0; font-size: 17px }
  @media (max-width: 760px) { .por { grid-template-columns: 1fr } }
  .metrics { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 20px }
  .metrics li { border-left: 2px solid var(--accent); padding: 2px 0 2px 14px }
  .metrics strong { display: block; font: 600 clamp(28px, 3.4vw, 40px)/1.1 var(--display); letter-spacing: -.02em }
  .metrics span { font-size: 14px; color: var(--muted) }
  .life { margin-top: 40px; max-width: 560px }
  .media { margin-top: 48px }
  .media video, .media img { width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--line); background: var(--surface) }
  figcaption { font-size: 13.5px; color: var(--muted); margin-top: 8px }
  .note { margin-top: 40px; font-size: 14px; color: var(--muted) }
  .sec { margin-top: 72px }
  .sec h2 { font-size: clamp(26px, 3.4vw, 36px) }
  .ba { border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--surface); margin-top: 20px }
  .ba-row { display: grid; grid-template-columns: 170px 1fr 1fr; border-top: 1px solid var(--line) }
  .ba-row:first-child { border-top: 0 }
  .ba-row > span { padding: 14px 18px; font-size: 15px; min-width: 0 }
  .ba-head span { font: 500 11px var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); padding-block: 10px }
  .ba-area { font-weight: 600; background: var(--bg) }
  .ba-b { color: var(--muted) }
  @media (max-width: 720px) {
    .ba-row { grid-template-columns: 1fr }
    .ba-head { display: none }
    .ba-row > span { padding: 8px 16px }
    .ba-area { padding-top: 12px !important }
    .ba-b::before { content: "Before · "; font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: .08em }
    .ba-a::before { content: "After · "; font: 500 11px var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--accent) }
    .ba-a { padding-bottom: 14px !important }
  }
  .flow { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; counter-reset: s }
  .flow li { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px }
  .flow span { font: 500 11px var(--mono); color: var(--accent) }
  .flow h3 { font-size: 18px; margin: 6px 0 6px }
  .flow p { margin: 0; font-size: 14.5px; color: var(--muted) }
  .prose { max-width: 760px; margin-left: auto; margin-right: auto }
  .prose :global(h2) { margin-top: 48px; font-size: clamp(24px, 3vw, 30px) }
  .prose :global(h2:first-child) { margin-top: 0 }
  .prose :global(h3) { font-size: 20px; margin: 28px 0 6px }
  .prose :global(li) { margin: 6px 0 }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: 15px; margin: 16px 0; display: block; overflow-x: auto }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 9px 10px; border-bottom: 1px solid var(--line); vertical-align: top }
  .prose :global(blockquote) { margin: 20px 0; padding: 12px 18px; border-left: 3px solid var(--accent); background: var(--accent-soft); border-radius: 0 8px 8px 0 }
  .shots { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; margin-top: 20px; align-items: start }
  .phones { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 20px; margin-top: 28px; align-items: start }
  .phones figure, .shots figure { margin: 0 }
  .shots img { border-radius: 8px; border: 1px solid var(--line); width: 100% }
  .phones img { border-radius: 18px; border: 4px solid var(--fg); width: 100%; max-width: 240px }
  @media (max-width: 400px) { .shots { grid-template-columns: 1fr } }
  .caveats { border-left: 3px solid var(--warn); padding: 4px 0 4px 20px }
  .caveats li { color: var(--muted); margin: 6px 0 }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px }
  .nextcase { margin-top: 96px }
  .nextcase a { display: block; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 32px 0; text-decoration: none; color: inherit }
  .nextcase span { font: 500 11px var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--muted) }
  .nextcase strong { display: block; font: 600 clamp(26px, 4vw, 40px) var(--display); letter-spacing: -.02em; margin: 6px 0; color: var(--accent) }
  .nextcase em { font-style: normal; color: var(--muted) }
</style>
