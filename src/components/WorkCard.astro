---
// Featured case-study card: problem, outcome, role, metrics, status and lifecycle
import type { CollectionEntry } from 'astro:content';
import Lifecycle from './Lifecycle.astro';
interface Props { entry: CollectionEntry<'work'>; index: number }
const { entry, index } = Astro.props;
const d = entry.data;
---
<article class="wc reveal">
  <div class="wc-side">
    <span class="wc-num">{String(index).padStart(2, '0')}</span>
    <div class="wc-tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
    <p class="wc-title">{d.title}</p>
    <p class="wc-company">{d.company} · {d.period}</p>
    {d.cover && <a href={`/work/${entry.id}/`} class="wc-img" tabindex="-1"><img src={d.cover} alt="" loading="lazy" width="1440" height="900" /></a>}
  </div>
  <div class="wc-main">
    <h3><a href={`/work/${entry.id}/`}>{d.headline}</a></h3>
    <dl class="wc-por">
      <div><dt>Problem</dt><dd>{d.problem}</dd></div>
      <div><dt>Outcome</dt><dd>{d.outcome}</dd></div>
      <div><dt>Role</dt><dd>{d.role}</dd></div>
    </dl>
    <ul class="wc-metrics">
      {d.metrics.slice(0, 3).map((m) => <li><strong>{m.value}</strong><span>{m.label}</span></li>)}
    </ul>
    <div class="wc-foot">
      <span class:list={['status', d.status.replace(' ', '-')]}>{d.status}</span>
      <div class="wc-life"><Lifecycle stages={d.stages} compact /></div>
      <a class="wc-link" href={`/work/${entry.id}/`}>View case study <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
<style>
  .wc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr); gap: 40px; padding: 44px 0; border-top: 1px solid var(--line) }
  .wc-num { font: 500 13px var(--mono); color: var(--accent) }
  .wc-tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0 }
  .wc-title { font: 600 14px var(--mono); letter-spacing: .1em; text-transform: uppercase; margin: 0 }
  .wc-company { font-size: 14px; color: var(--muted); margin: 4px 0 18px }
  .wc-img img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: 8px; border: 1px solid var(--line) }
  .wc h3 { font-size: clamp(24px, 2.8vw, 34px); margin: 0 0 22px }
  .wc h3 a { color: inherit; text-decoration: none }
  .wc h3 a:hover { color: var(--accent) }
  .wc-por { margin: 0; display: grid; gap: 14px }
  .wc-por div { display: grid; grid-template-columns: 96px 1fr; gap: 16px }
  .wc-por dt { font: 500 11px var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--muted); padding-top: 4px }
  .wc-por dd { margin: 0; font-size: 16px }
  .wc-metrics { list-style: none; padding: 0; margin: 26px 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px }
  .wc-metrics li { border-left: 2px solid var(--accent); padding: 2px 0 2px 12px }
  .wc-metrics strong { display: block; font: 600 clamp(24px, 2.6vw, 32px)/1.1 var(--display); letter-spacing: -.02em }
  .wc-metrics span { font-size: 13.5px; color: var(--muted) }
  .wc-foot { display: grid; grid-template-columns: auto minmax(140px, 220px) 1fr; gap: 20px; align-items: center }
  .wc-link { justify-self: end; font-weight: 600; text-decoration: none; white-space: nowrap }
  @media (max-width: 860px) {
    .wc { grid-template-columns: 1fr; gap: 20px; padding: 36px 0 }
    .wc-por div { grid-template-columns: 1fr; gap: 2px }
    .wc-metrics { grid-template-columns: 1fr; gap: 14px }
    .wc-foot { grid-template-columns: 1fr; gap: 14px }
    .wc-link { justify-self: start }
  }
</style>
